pragma solidity ^0.8.35;

// Canonical OutrunDeployer creation bytecode, pinned as a constant.
//
// solc's via_ir output for this contract is optimizer-runs sensitive (measured: the 15000
// and 100000 builds differ byte-for-byte), and the CREATE2 pin assert runs in EVERY batch
// while batches compile at different tiers — a `type(OutrunDeployer).creationCode` recipe
// would therefore compute a different expected address per batch and the orchestrator can
// never pass phase 2. Embedding the bytes makes the recipe tier-invariant and drift-proof
// by construction (same pattern as Memeverse's RealV4PoolManagerBytecode).
//
// Source: script/deploy/deployment/OutrunDeployer.sol built with
//         solc 0.8.35 / --optimize --optimizer-runs 100000 --via-ir
//         (the deployer batch's tier). Verified to reproduce the canonical CREATE2
//         address 0x7024B5325E9A84aF01a092C0f3b82aF6bBa722BC already live on
//         bsc/base/arbitrum testnet under salt keccak256(owner, "OutrunDeployerV1", 1).
//         Regenerating this constant is a DEPLOYER ADDRESS MIGRATION: every real chain
//         needs a fresh phase-1 bootstrap and pin.
bytes constant CANONICAL_OUTRUN_DEPLOYER_CREATION_CODE =
    hex"";
