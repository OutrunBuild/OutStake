{
  "full_review_matrix": {
    "no-op": [],
    "non-semantic": [],
    "prod-semantic": [
      "logic-reviewer",
      "security-reviewer",
      "refinement-reviewer"
    ],
    "test-semantic": [
      "logic-reviewer"
    ]
  },
  "hard_blocks": [],
  "orchestration_review_roles": {
    "no-op": [],
    "non-semantic": [],
    "prod-semantic-risk-analysis-passed": [
      "logic-reviewer"
    ],
    "test-semantic": [
      "logic-reviewer"
    ]
  },
  "orchestration_rules": {
    "doc_round": {
      "trigger_change_class": [
        "prod-semantic"
      ],
      "writer_role": "process-implementer"
    },
    "scope_escalation": {
      "prod_solidity_max_files_before_full_review": 1,
      "prod_solidity_max_semantic_lines_before_full_review": 20
    },
    "spec_paths": [
      "(^|.*/)(spec|specs)/.*\\.(md|mdx)$"
    ],
    "surface_sensitivity": {
      "harness_control": "normal",
      "solidity_prod": "sensitive",
      "solidity_test": "normal"
    }
  },
  "repo": "OutStakeV2",
  "risk_rules": {
    "slither_exclude_detectors": "naming-convention,too-many-digits,unindexed-event-address,immutable-states,unimplemented-functions",
    "slither_filter_paths": "lib|test|script|node_modules"
  },
  "surfaces": {
    "harness_control": [
      "(^|.*/)(spec|specs)/.*\\.(md|mdx)$",
      "^AGENTS\\.md$",
      "^(src|test|script)/AGENTS\\.md$",
      "^CLAUDE\\.md$",
      "^README\\.md$",
      "^\\.claude/agents/.*$",
      "^\\.claude/rules/.*$",
      "^\\.claude/settings\\.json$",
      "^\\.pi/agents/.*$",
      "^\\.pi/extensions/.*$",
      "^\\.pi/settings\\.json$",
      "^\\.pi/skills/.*$",
      "^\\.codex/agents/.*$",
      "^\\.dsh/skills/.*$",
      "^\\.codex/skills/.*$",
      "^\\.zcode/agents/.*$",
      "^\\.zcode/skills/.*$",
      "^\\.githooks/.*$",
      "^\\.github/pull_request_template\\.md$",
      "^\\.github/workflows/.*$",
      "^\\.github/workflows/pr-template-check\\.yml$",
      "^\\.gitmodules$",
      "^\\.gitignore$",
      "^\\.env\\.example$",
      "^\\.harness/policy\\.json$",
      "^\\.harness/runtime/main-session-contract\\.md$",
      "^\\.harness/schemas/.*$",
      "^docs/.*$",
      "^foundry\\.toml$",
      "^foundry\\.lock$",
      "^lib/ds-test$",
      "^lib/forge-std$",
      "^lib/layerzerolabs/devtools$",
      "^lib/layerzerolabs/lz-evm-protocol-v2$",
      "^lib/openzeppelin-contracts-upgradeable$",
      "^lib/solidity-bytes-utils$",
      "^lib/solmate$",
      "^npm-shrinkwrap\\.json$",
      "^package-lock\\.json$",
      "^package\\.json$",
      "^remappings\\.txt$",
      "^script/harness/.*$",
      "^script/ops/.*\\.sh$",
      "^\\.?solhint.*(\\.config\\.js|\\.json)$"
    ],
    "solidity_prod": [
      "^src/.*\\.sol$",
      "^script/.*\\.sol$"
    ],
    "solidity_test": [
      "^test/.*\\.sol$"
    ]
  },
  "test_mapping": {
    "assets": {
      "tests": [
        "test/upgradeable/OutrunOFTUpgradeable.t.sol",
        "test/upgradeable/OutrunUniversalAssetsUpgradeable.t.sol"
      ],
      "rules": [
        {
          "id": "assets-core",
          "paths": [
            "^src/assets/.*\\.sol$"
          ],
          "change_tests": [
            "test/upgradeable/OutrunOFTUpgradeable.t.sol",
            "test/upgradeable/OutrunUniversalAssetsUpgradeable.t.sol"
          ],
          "evidence_tests": [
            "test/upgradeable/OutrunOFTUpgradeable.t.sol",
            "test/upgradeable/OutrunUniversalAssetsUpgradeable.t.sol"
          ]
        }
      ]
    },
    "position": {
      "tests": [
        "test/upgradeable/OutrunStakingPositionUpgradeable.t.sol",
        "test/upgradeable/OutrunStakingPositionFuzzUpgradeable.t.sol",
        "test/upgradeable/OutrunStakingPositionInvariantUpgradeable.t.sol",
        "test/upgradeable/KeepWrapRedeemAccess.t.sol",
        "test/upgradeable/OutrunStakingPositionStorageLayout.t.sol"
      ],
      "rules": [
        {
          "id": "position-core",
          "paths": [
            "^src/position/.*\\.sol$"
          ],
          "change_tests": [
            "test/upgradeable/OutrunStakingPositionUpgradeable.t.sol",
            "test/upgradeable/OutrunStakingPositionFuzzUpgradeable.t.sol",
            "test/upgradeable/KeepWrapRedeemAccess.t.sol",
            "test/upgradeable/OutrunStakingPositionStorageLayout.t.sol"
          ],
          "evidence_tests": [
            "test/upgradeable/OutrunStakingPositionUpgradeable.t.sol",
            "test/upgradeable/OutrunStakingPositionFuzzUpgradeable.t.sol",
            "test/upgradeable/KeepWrapRedeemAccess.t.sol",
            "test/upgradeable/OutrunStakingPositionStorageLayout.t.sol"
          ]
        }
      ]
    },
    "router": {
      "tests": [
        "test/upgradeable/OutrunRouterUpgradeable.t.sol",
        "test/upgradeable/OutrunRouterFuzzUpgradeable.t.sol",
        "test/upgradeable/RouterProxyIntegration.t.sol"
      ],
      "rules": [
        {
          "id": "router-core",
          "paths": [
            "^src/router/.*\\.sol$"
          ],
          "change_tests": [
            "test/upgradeable/OutrunRouterUpgradeable.t.sol",
            "test/upgradeable/OutrunRouterFuzzUpgradeable.t.sol",
            "test/upgradeable/RouterProxyIntegration.t.sol"
          ],
          "evidence_tests": [
            "test/upgradeable/OutrunRouterUpgradeable.t.sol",
            "test/upgradeable/OutrunRouterFuzzUpgradeable.t.sol",
            "test/upgradeable/RouterProxyIntegration.t.sol"
          ]
        }
      ]
    },
    "yield": {
      "tests": [
        "test/upgradeable/SYUpgradeable.t.sol",
        "test/upgradeable/SYAdaptersUpgradeable.t.sol",
        "test/upgradeable/SYAdaptersFork.t.sol",
        "test/upgradeable/OracleSetterUpgradeable.t.sol"
      ],
      "rules": [
        {
          "id": "yield-core",
          "paths": [
            "^src/yield/.*\\.sol$",
            "^src/integrations/.*\\.sol$"
          ],
          "change_tests": [
            "test/upgradeable/SYUpgradeable.t.sol",
            "test/upgradeable/SYAdaptersUpgradeable.t.sol",
            "test/upgradeable/OracleSetterUpgradeable.t.sol"
          ],
          "evidence_tests": [
            "test/upgradeable/SYUpgradeable.t.sol",
            "test/upgradeable/SYAdaptersUpgradeable.t.sol",
            "test/upgradeable/OracleSetterUpgradeable.t.sol"
          ]
        }
      ]
    },
    "deployment": {
      "tests": [
        "test/deploy/OutstakeScriptUpgradeable.t.sol",
        "test/deploy/YieldDeployScriptUpgradeable.t.sol",
        "test/upgradeable/OutstakeScriptMockSYDeploy.t.sol"
      ],
      "rules": [
        {
          "id": "deployment-outstake-script",
          "paths": [
            "^script/deploy/OutstakeScript\\.s\\.sol$"
          ],
          "change_tests": [
            "test/deploy/OutstakeScriptUpgradeable.t.sol",
            "test/upgradeable/OutstakeScriptMockSYDeploy.t.sol"
          ],
          "evidence_tests": [
            "test/deploy/OutstakeScriptUpgradeable.t.sol",
            "test/upgradeable/OutstakeScriptMockSYDeploy.t.sol"
          ]
        },
        {
          "id": "deployment-yield-deploy-script",
          "paths": [
            "^script/deploy/YieldDeployScript\\.s\\.sol$"
          ],
          "change_tests": [
            "test/deploy/YieldDeployScriptUpgradeable.t.sol"
          ],
          "evidence_tests": [
            "test/deploy/YieldDeployScriptUpgradeable.t.sol"
          ]
        }
      ]
    },
    "libraries": {
      "tests": [
        "test/support/Libraries.t.sol",
        "test/support/TokenHelper.t.sol",
        "test/support/MockOracleWarnings.t.sol"
      ],
      "rules": [
        {
          "id": "libraries-core",
          "paths": [
            "^src/libraries/.*\\.sol$"
          ],
          "change_tests": [
            "test/support/Libraries.t.sol",
            "test/support/TokenHelper.t.sol",
            "test/support/MockOracleWarnings.t.sol"
          ],
          "evidence_tests": [
            "test/support/Libraries.t.sol",
            "test/support/TokenHelper.t.sol",
            "test/support/MockOracleWarnings.t.sol"
          ]
        }
      ]
    },
    "security": {
      "tests": [
        "test/upgradeable/AdversarialTestsUpgradeable.t.sol"
      ],
      "rules": [
        {
          "id": "security-sensitive-scope",
          "paths": [
            "^src/assets/.*\\.sol$",
            "^src/position/.*\\.sol$",
            "^src/yield/.*\\.sol$",
            "^src/router/.*\\.sol$",
            "^src/integrations/.*\\.sol$",
            "^src/libraries/.*\\.sol$",
            "^script/.*\\.sol$"
          ],
          "change_tests": [
            "test/upgradeable/AdversarialTestsUpgradeable.t.sol"
          ],
          "evidence_tests": [
            "test/upgradeable/AdversarialTestsUpgradeable.t.sol"
          ]
        }
      ]
    }
  },
  "testing_gaps": {
    "unregistered-test-files": [
      {
        "id": "outstake-router-drift-fix-gap",
        "paths": [
          "test/deploy/OutstakeRouterDriftFix.t.sol"
        ],
        "status": "new test file not yet covered by test_mapping; explicit gap pending the owning change's registration",
        "enforcement": "residual-risk"
      }
    ]
  },
  "verification_profiles": {
    "ci": {
      "required_commands": [
        "fmt_changed_solidity",
        "lint_changed_solidity",
        "forge_build",
        "forge_test_full",
        "coverage_when_required",
        "slither_when_required",
        "bash_syntax_changed_shell",
        "node_syntax_changed_js",
        "npm_ci_when_package_changes"
      ]
    },
    "fast": {
      "required_commands": [
        "fmt_changed_solidity",
        "lint_changed_solidity",
        "forge_build",
        "targeted_tests",
        "bash_syntax_changed_shell",
        "node_syntax_changed_js",
        "npm_ci_when_package_changes"
      ]
    },
    "full": {
      "required_commands": [
        "fmt_changed_solidity",
        "lint_changed_solidity",
        "forge_build",
        "forge_test_full",
        "coverage_when_required",
        "slither_when_required",
        "bash_syntax_changed_shell",
        "node_syntax_changed_js",
        "npm_ci_when_package_changes"
      ]
    }
  },
  "version": 1,
  "write_roles": {
    "harness_control": "process-implementer",
    "solidity_prod": "solidity-implementer",
    "solidity_test": "solidity-implementer"
  }
}
