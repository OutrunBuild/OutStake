# OutStakeV2 environment template
#
# Copy this file to `.env` and fill in the values. This file IS committed to VCS;
# the real `.env` is gitignored (`.gitignore` ignores `.env` and `.env.*`, while
# `!.env.example` keeps this committed template). Never commit real secrets.
#
# Required vars are read by the deploy scripts (script/deploy/*.sol via
# `vm.env*("X")`), the ops wrappers (script/ops/deploy.sh / yieldDeploy.sh,
# which `source .env`), and foundry.toml (`${X}` substitutions).
#
# All values here are placeholders — fill real values only in your local `.env`.

# ---- Key management ---------------------------------------------------------
# Unconditionally read by BaseScript.setUp(); the only supported key source.
PRIVATE_KEY=

# ---- Protocol addresses -----------------------------------------------------
# Set on the target deployment (per-chain where relevant).
OWNER=
KEEPER=
REVENUE_POOL=
OUTRUN_DEPLOYER=
OUTRUN_ROUTER=
MEMEVERSE_LAUNCHER=

# ---- Yield / collateral token addresses ------------------------------------
UETH=
UUSD=
SEPOLIA_STETH=
SEPOLIA_WSTETH=
SEPOLIA_SUSDE=
SEPOLIA_USDE=
MOCK_USDC=
MOCK_AUSDC=
MOCK_SUSDS=
MOCK_AUSDC_ORACLE=
MOCK_USDC_ORACLE=
MOCK_SUSDS_ORACLE=
MOCK_AUSDC_SY=
MOCK_SUSDS_SY=

# ---- LayerZero endpoints / EIDs (per chain) --------------------------------
ETHEREUM_SEPOLIA_ENDPOINT=
ETHEREUM_SEPOLIA_EID=
ETHEREUM_SEPOLIA_CHAINID=
ARBITRUM_SEPOLIA_ENDPOINT=
ARBITRUM_SEPOLIA_EID=
ARBITRUM_SEPOLIA_CHAINID=
ARBITRUM_SEPOLIA_AUSDC=
ARBITRUM_SEPOLIA_POOL=
AVALANCHE_FUJI_ENDPOINT=
AVALANCHE_FUJI_EID=
BASE_SEPOLIA_ENDPOINT=
BASE_SEPOLIA_EID=
BASE_SEPOLIA_CHAINID=
BASE_SEPOLIA_AUSDC=
BASE_SEPOLIA_POOL=
BERA_SEPOLIA_ENDPOINT=
BERA_SEPOLIA_EID=
BLAST_SEPOLIA_ENDPOINT=
BLAST_SEPOLIA_EID=
BSC_TESTNET_ENDPOINT=
BSC_TESTNET_EID=
LINEA_SEPOLIA_ENDPOINT=
LINEA_SEPOLIA_EID=
MONAD_TESTNET_ENDPOINT=
MONAD_TESTNET_EID=
OPTIMISTIC_SEPOLIA_ENDPOINT=
OPTIMISTIC_SEPOLIA_EID=
POLYGON_AMOY_ENDPOINT=
POLYGON_AMOY_EID=
SCROLL_SEPOLIA_ENDPOINT=
SCROLL_SEPOLIA_EID=
SONIC_TESTNET_ENDPOINT=
SONIC_TESTNET_EID=
ZKSYNC_SEPOLIA_ENDPOINT=
ZKSYNC_SEPOLIA_EID=

# ---- RPC URLs (per chain, read by foundry.toml) ----------------------------
ETHEREUM_SEPOLIA_RPC=
ARBITRUM_SEPOLIA_RPC=
AVALANCHE_FUJI_RPC=
