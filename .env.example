# OutStake environment template
#
# Copy this file to `.env` and fill in the values. This file IS committed to VCS;
# the real `.env` is gitignored (`.gitignore` ignores `.env` and `.env.*`, while
# `!.env.example` keeps this committed template). Never commit real secrets.
#
# Required vars are read by the deploy scripts (script/deploy/*.sol via
# `vm.env*("X")`), the ops wrappers (script/ops/deploy.sh / yieldDeploy.sh,
# which `source .env`), and foundry.toml (`${X}` substitutions).
#
# All values here are placeholders — fill real values only in your local `.env`.

# ---- Key management ---------------------------------------------------------
# Unconditionally read by BaseScript.setUp(); the only supported key source.
# Deployer private key (required, no default): read unconditionally by BaseScript.setUp().
PRIVATE_KEY=
# Deployer owner address (required): must equal the PRIVATE_KEY-derived broadcaster on both scripts' live paths.
OWNER=

# ---- Protocol addresses -----------------------------------------------------
# Set on the target deployment (per-chain where relevant).
# Deployed OutrunRouter (required on YieldDeployScript Base Sepolia path): SY trusted-router
# auto-wiring; missing key reverts after SY creation (optional on OutstakeScript paths).
OUTRUN_ROUTER=
# Protocol treasury (required on Yield path): read unconditionally by YieldDeployScript.run().
PROTOCOL_TREASURY=
# OutrunDeployer (required by OutstakeScript router path): read unconditionally by OutstakeScript.run();
# must equal the CREATE2 expected address enforced by _assertOutrunDeployer (same owner/nonce/build),
# otherwise the deploy reverts.
OUTRUN_DEPLOYER=
# Memeverse launcher (required by OutstakeScript router path): router deployment recipient.
MEMEVERSE_LAUNCHER=

# PSM fee recipient (required, no default): treasury/finance address that receives
# fee-surplus payouts via PSM sweepFees(); zero or unset fails the deploy fast.
PSM_FEE_RECIPIENT=

# ---- uAsset outbound rate limits (per destination, read by the deploy script) -------------
# Values are in LOCAL decimals (LD), the same unit as on-chain transfer amounts. The uAssets are
# 18-dec, so 1 token = 1e18 and a limit of 1,000,000 tokens is written as 1000000e18.
# WARNING: do NOT use shared-decimals (SD / 6-dec) magnitudes — for these 18-dec tokens a value
# like 1e12 is one dust unit (1e-6 token), not 1M tokens, and would freeze outbound sends.
# Both keys are required per family once the uAsset cross-chain deploy calls are uncommented;
# WINDOW is in seconds and must satisfy limit >= window (deploy reverts fail-fast if either key
# is missing or zero).
UETH_OUTBOUND_RATE_LIMIT=
UETH_OUTBOUND_RATE_WINDOW_SECONDS=
UUSD_OUTBOUND_RATE_LIMIT=
UUSD_OUTBOUND_RATE_WINDOW_SECONDS=
UBNB_OUTBOUND_RATE_LIMIT=
UBNB_OUTBOUND_RATE_WINDOW_SECONDS=

# ---- Yield / collateral token addresses ------------------------------------
# Deployed family uAsset addresses (fill after OutstakeScript runs; chain-specific)
UETH=
UUSD=
UBNB=

# ---- LayerZero endpoints / EIDs (per chain) --------------------------------
ETHEREUM_SEPOLIA_ENDPOINT=
ETHEREUM_SEPOLIA_EID=
ETHEREUM_SEPOLIA_CHAINID=
BASE_SEPOLIA_ENDPOINT=
BASE_SEPOLIA_EID=
BASE_SEPOLIA_CHAINID=
BASE_SEPOLIA_AUSDC=
BASE_SEPOLIA_POOL=
BSC_TESTNET_ENDPOINT=
BSC_TESTNET_EID=
BSC_TESTNET_CHAINID=
BSC_TESTNET_SLISBNB=
BSC_TESTNET_LISTA_STAKE_MANAGER=

# ---- RPC URLs (per chain, read by foundry.toml) ----------------------------
ETHEREUM_SEPOLIA_RPC=
BASE_SEPOLIA_RPC=
BSC_TESTNET_RPC=
BSC_MAINNET_RPC=
ETHEREUM_MAINNET_RPC=
BASE_MAINNET_RPC=

# ---- Etherscan (read by foundry.toml verify config) -------------------------
ETHEREUMSCAN_API_KEY=
ETHEREUMSCAN_API_URL=
